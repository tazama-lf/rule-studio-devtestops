# Application
NODE_ENV=dev
HOST=0.0.0.0
PORT=3050
LOG_LEVEL=info
FUNCTION_NAME=simulation-sandbox

# Encryption Key (must be exactly 32 bytes for AES-256)
ENCRYPTION_IV=<Multiple_Tenant_Based_IV>
ENCRYPTION_KEY=<Multiple_Tenant_Based_Secret_Key>

# NATS Configuration
NATS_URL=nats://<NATS_HOST>:<NATS_PORT>

# GitHub Configuration
GITHUB_API_URL=https://api.github.com
GITHUB_TEMPLATE_OWNER=tazama-lf
GITHUB_BRANCH=main
GITHUB_TEMPLATE_REPO=rule-studio-example
GITHUB_TEST_REPORT_PATH=reports/unit-tests/latest/index.html
GITHUB_TOKEN=<AES_ENCRYPTED_GITHUB_TOKEN>
GITHUB_ORG_NAME=psl-copilot
GITHUB_INIT_BRANCH=staging

# Auth-lib JWT Certificate Paths
CERT_PATH_PRIVATE=./certs/private-key.pem
CERT_PATH_PUBLIC=./certs/public-key.pem