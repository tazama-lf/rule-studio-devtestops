tatements</span> :\n                            <span class=\"summary-value\">100.00% ( 82/82 )</span>\n                        </div>\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">Branches</span>   :\n                            <span class=\"summary-value\">100.00% ( 16/16 )</span>\n                        </div>\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">Functions</span>  :\n                            <span class=\"summary-value\">100.00% ( 1/1 )</span>\n                        </div>\n                        <div class=\"summary-row\">\n                            <span class=\"summary-label\">Lines</span>      :\n                            <span class=\"summary-value\">100.00% ( 82/82 )</span>\n                        </div>\n                        <div class=\"summary-footer\">================================================================================</div>\n                    </div>\n                </div>\n                <div class=\"test-section\">\n                    <h2>Test Execution Details</h2>\n                    <div class=\"test-cards-grid\">\n                        <div class=\"test-card passed\">\n                            <span class=\"test-icon\">✅</span>\n                            <span class=\"test-name\">Should respond with .01: The debtor has performed one transaction to date</span>\n                            <span class=\"test-duration\">4ms</span>\n                        </div>\n                        <div class=\"test-card passed\">\n                            <span class=\"test-icon\">✅</span>\n                            <span class=\"test-name\">Should respond with .02: The debtor has performed two or three transactions to date</span>\n                            <span class=\"test-duration\">1ms</span>\n                        </div>\n                        <div class=\"test-card